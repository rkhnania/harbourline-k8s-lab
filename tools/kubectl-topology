#!/usr/bin/env python3
"""Emit a styled Mermaid topology diagram for a namespace, from live cluster state."""
import json, subprocess, argparse

ICON = {"Deployment": "🚀", "StatefulSet": "🗄️", "DaemonSet": "🛰️"}

def sid(name, prefix):
    return prefix + "_" + name.replace("-", "_").replace(".", "_")

def kget(ns, kinds):
    out = subprocess.run(["kubectl", "get", kinds, "-n", ns, "-o", "json"],
                         capture_output=True, text=True, check=True).stdout
    return json.loads(out).get("items", [])

def main():
    ap = argparse.ArgumentParser(prog="kubectl topology")
    ap.add_argument("-n", "--namespace", default="default")
    ns = ap.parse_args().namespace

    items = kget(ns, "ingress,service,deployment,statefulset")
    ingresses = [i for i in items if i["kind"] == "Ingress"]
    services  = [i for i in items if i["kind"] == "Service"]
    workloads = [i for i in items if i["kind"] in ("Deployment", "StatefulSet")]

    L = ["flowchart LR", '  internet(["🌐 Internet"])', "", '  subgraph ns["☸️  namespace: %s"]' % ns, "    direction LR"]
    edges, classes = [], {"ing": [], "svc": [], "hsvc": [], "wl": [], "sts": []}

    for ing in ingresses:
        i = sid(ing["metadata"]["name"], "ing")
        hosts = ", ".join(r.get("host", "*") for r in ing["spec"].get("rules", []))
        L.append('    %s[["🚪 Ingress<br/>%s"]]' % (i, hosts))
        classes["ing"].append(i)
        edges.append("  internet ==> %s" % i)
        for rule in ing["spec"].get("rules", []):
            for p in rule.get("http", {}).get("paths", []):
                edges.append('  %s -->|"%s"| %s'
                             % (i, p.get("path", "/"), sid(p["backend"]["service"]["name"], "svc")))

    for svc in services:
        sel = svc["spec"].get("selector") or {}
        s = sid(svc["metadata"]["name"], "svc")
        ports = ",".join(str(p.get("port")) for p in svc["spec"].get("ports", []))
        headless = svc["spec"].get("clusterIP") == "None"
        icon = "🧭" if headless else "🔀"
        extra = "<br/><i>headless</i>" if headless else ""
        L.append('    %s(["%s %s<br/>:%s%s"])' % (s, icon, svc["metadata"]["name"], ports, extra))
        classes["hsvc" if headless else "svc"].append(s)
        for wl in workloads:
            wlabels = wl["spec"]["template"]["metadata"].get("labels", {})
            if sel and all(wlabels.get(k) == v for k, v in sel.items()):
                w = sid(wl["metadata"]["name"], "wl")
                ready = wl["status"].get("readyReplicas", 0)
                want = wl["spec"].get("replicas", 0)
                dot = "🟢" if ready == want and want else "🔴"
                L.append('    %s["%s %s<br/>%s<br/>%s %s/%s ready"]'
                         % (w, ICON.get(wl["kind"], "📦"), wl["metadata"]["name"],
                            wl["kind"], dot, ready, want))
                classes["sts" if wl["kind"] == "StatefulSet" else "wl"].append(w)
                edges.append("  %s --> %s" % (s, w))

    L += ["  end", ""] + sorted(set(edges)) + ["",
        "  classDef ing  fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#78350f",
        "  classDef svc  fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#1e3a8a",
        "  classDef hsvc fill:#ede9fe,stroke:#7c3aed,stroke-width:2px,color:#4c1d95",
        "  classDef wl   fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#14532d",
        "  classDef sts  fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#881337",
    ]
    for cls, ids in classes.items():
        if ids:
            L.append("  class %s %s" % (",".join(sorted(set(ids))), cls))
    print("\n".join(L))

if __name__ == "__main__":
    main()
