# Secrets — never commit
*.env
!*.env.example
db.env

# Backups
*.tgz

# Python
__pycache__/
*.pyc
venv/
.venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
k8s/secret.yaml
etcd-snapshot.db

# Terraform
# The lock file IS committed - it is what pins provider versions with
# checksums, and without it two people on the same commit can get different
# providers. Everything below is either a local cache or state containing
# cluster credentials in plaintext.
.terraform/
*.tfstate
*.tfstate.*
!.terraform.lock.hcl
crash.log
*.tfvars
!*.tfvars.example
